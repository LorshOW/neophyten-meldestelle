APP_NAME="Neophyten-Meldestelle"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Switch to MAMP MySQL by setting DB_CONNECTION=mysql and uncommenting:
# DB_HOST=127.0.0.1
# DB_PORT=8889
# DB_DATABASE=neophyten_meldestelle
# DB_USERNAME=root
# DB_PASSWORD=root
# DB_SOCKET=/Applications/MAMP/tmp/mysql/mysql.sock

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="naturmeldung.erzgebirge@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- KoboToolbox -------------------------------------------------------
# Public Enketo form the PWA hands off to (unchanged from the static app).
KOBO_FORM_URL=https://ee-eu.kobotoolbox.org/x/aeG09o4G
# KPI API base for the EU server (used for attachments + backfill sync).
KOBO_API_BASE=https://eu.kobotoolbox.org
KOBO_API_TOKEN=
KOBO_ASSET_UID=
# Shared secret sent by the Kobo REST Service as a custom header.
KOBO_WEBHOOK_SECRET=
# Optional comma-separated IP allowlist for the webhook endpoint.
KOBO_WEBHOOK_IPS=

# --- Meldestelle -------------------------------------------------------
# Days a closed Vorgang is retained before vorgaenge:purge removes it.
# Empty = keep indefinitely.
MELDESTELLE_RETENTION_DAYS=
